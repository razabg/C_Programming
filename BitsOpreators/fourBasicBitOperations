#include <stdio.h>

/*
 * printBits - prints the binary representation of an 8-bit number
 *
 * How it works:
 * We loop from bit 7 (leftmost) down to bit 0 (rightmost).
 * For each position, we shift the number right by i positions,
 * then AND with 1 to isolate that single bit.
 *
 * Example: num = 0b10110010, i = 7
 *   num >> 7  = 0b00000001
 *   & 1       = 1           ← the leftmost bit
 */
void printBits(unsigned char num)
{
    for (int i = 7; i >= 0; i--)
        printf("%d", (num >> i) & 1);
    printf("\n");
}

/*
 * setBit - forces a specific bit to 1, leaves all others unchanged
 *
 * How it works:
 * (1 << pos) creates a mask with only bit 'pos' set to 1.
 * OR (|) with the number: if the bit was 0, it becomes 1.
 *                         if the bit was 1, it stays 1.
 *
 * Example: setBit(0b10110010, 3)
 *
 *   num       = 10110010
 *   1 << 3    = 00001000    ← mask: only bit 3 is 1
 *   ──────────────────────
 *   OR result = 10111010    ← bit 3 is now ON, rest unchanged
 *
 * Why OR?
 *   0 | 0 = 0   ← unchanged
 *   1 | 0 = 1   ← unchanged
 *   0 | 1 = 1   ← forced to 1
 *   1 | 1 = 1   ← stays 1
 */
unsigned char setBit(unsigned char num, int pos)
{
    return num | (1 << pos);
}

/*
 * clearBit - forces a specific bit to 0, leaves all others unchanged
 *
 * How it works:
 * (1 << pos) creates a mask with only bit 'pos' set to 1.
 * ~(1 << pos) inverts it: now every bit is 1 EXCEPT bit 'pos'.
 * AND (&) with the number: bit 'pos' gets forced to 0,
 *                          all other bits pass through unchanged.
 *
 * Example: clearBit(0b10110010, 4)
 *
 *   num       = 10110010
 *   1 << 4    = 00010000    ← mask
 *   ~(1 << 4) = 11101111    ← inverted: bit 4 is 0, rest are 1
 *   ──────────────────────
 *   AND result= 10100010    ← bit 4 is now OFF, rest unchanged
 *
 * Why AND with inverted mask?
 *   1 & 1 = 1   ← unchanged
 *   0 & 1 = 0   ← unchanged
 *   1 & 0 = 0   ← forced to 0
 *   0 & 0 = 0   ← stays 0
 */
unsigned char clearBit(unsigned char num, int pos)
{
    return num & ~(1 << pos);
}

/*
 * toggleBit - flips a specific bit (0→1 or 1→0), leaves others unchanged
 *
 * How it works:
 * (1 << pos) creates a mask with only bit 'pos' set to 1.
 * XOR (^) with the number: if the bit was 0, it becomes 1.
 *                           if the bit was 1, it becomes 0.
 *
 * Example: toggleBit(0b10110010, 7)
 *
 *   num       = 10110010
 *   1 << 7    = 10000000    ← mask: only bit 7 is 1
 *   ──────────────────────
 *   XOR result= 00110010    ← bit 7 flipped from 1 to 0
 *
 * Why XOR?
 *   0 ^ 0 = 0   ← unchanged
 *   1 ^ 0 = 1   ← unchanged
 *   0 ^ 1 = 1   ← flipped!
 *   1 ^ 1 = 0   ← flipped!
 *   The key: XOR with 1 always flips, XOR with 0 never changes.
 */
unsigned char toggleBit(unsigned char num, int pos)
{
    return num ^ (1 << pos);
}

/*
 * checkBit - reads the value of a specific bit (returns 0 or 1)
 *
 * How it works:
 * Shift the number right by 'pos' positions, moving the target bit
 * to position 0. Then AND with 1 to isolate just that bit.
 *
 * Example: checkBit(0b10110010, 1)
 *
 *   num       = 10110010
 *   num >> 1  = 01011001    ← shifted right, bit 1 is now at position 0
 *   & 1       = 00000001    ← isolate the last bit = 1
 *   result    = 1           ← bit 1 is ON
 *
 * Example: checkBit(0b10110010, 3)
 *
 *   num       = 10110010
 *   num >> 3  = 00010110    ← shifted right, bit 3 is now at position 0
 *   & 1       = 00000000    ← isolate the last bit = 0
 *   result    = 0           ← bit 3 is OFF
 *
 * Alternative approach (same result):
 *   return (num & (1 << pos)) != 0;
 *   This ANDs the number with a mask, and checks if the result is non-zero.
 *   Both work — the shift approach is slightly cleaner.
 */
int checkBit(unsigned char num, int pos)
{
    return (num >> pos) & 1;
}

int main()
{
    unsigned char num = 0b10110010;

    printf("Original:  ");
    printBits(num);
    printf("Set 3:     ");
    printBits(setBit(num, 3));
    printf("Clear 4:   ");
    printBits(clearBit(num, 4));
    printf("Toggle 7:  ");
    printBits(toggleBit(num, 7));
    printf("Bit 1:     %s\n", checkBit(num, 1) ? "ON" : "OFF");

    return 0;
}